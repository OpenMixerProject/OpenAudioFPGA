#!/bin/sh
export PATH=/bin LC_ALL=C
umask 077

ack='LOAD FABRIC ID: RAM, ISOLATION AND R2 VERIFIED'
early() {
    printf 'WING_DIAG_V1 event=init %s\n' "$*"
    printf 'WING_DIAG_V1 event=init %s\n' "$*" >>/run/wing-diag-early
}
for spec in 'proc /proc' 'sysfs /sys' 'devtmpfs /dev' 'tmpfs /run'; do
    set -- $spec
    mount -t "$1" "$1" "$2" || failed=yes
done
early 'stage=entry profile=fabric-id-manual'
if [ "$failed" = yes ]; then
    early 'stage=mount state=error code=no-loader'
    attempted=yes
fi

# No shell/getty on CDC. Only exact operator acknowledgement, once per boot.
# Record the result on the early console and replay it for a later USB Recorder.
while :; do
    if [ -c /dev/ttyGS0 ] && stty -F /dev/ttyGS0 115200 cs8 -parenb -cstopb icanon -echo icrnl; then
        state=$(cat /sys/bus/spi/devices/spi1.1/state 2>/dev/null) || state=unknown
        ready=no
        if [ "$state" = offline ] && [ -c /dev/spibone0 ] && [ -c /dev/spidev1.0 ] && [ ! -e /dev/spidev1.1 ]; then
            ready=yes
        fi
        wing-t55-diag >/run/wing-diag.latest
        printf 'WING_FABRIC_ID_V1 event=preflight ss1_state=%s transport_ready=%s attempted=%s\n' \
            "$state" "$ready" "${attempted:-no}" >>/run/wing-diag.latest
        timeout -k 1 3 sh -c 'exec cat /run/wing-diag.latest > /dev/ttyGS0' 2>/dev/null || :
        if [ "$attempted" = yes ]; then
            timeout -k 1 3 sh -c 'exec cat /run/wing-fabric-id.log > /dev/ttyGS0' 2>/dev/null || :
        elif [ "$ready" = yes ]; then
            if timeout -k 1 3 sh -c 'IFS= read -r line && [ "$line" = "$1" ]' sh "$ack" </dev/ttyGS0; then
                attempted=yes
                wing-fabric-id "$ack" >/run/wing-fabric-id.log 2>&1 || :
                cat /run/wing-fabric-id.log
            fi
        fi
    fi
    sleep 1
done
