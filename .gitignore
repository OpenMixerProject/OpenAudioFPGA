*.bit
*.bin
*.jed
*.mcs
*.svf
*.xcf
*.rbf
*.sof
*.pof
*.hex
*.hexbin

# ---- Lattice Diamond -------------------------------------------------------
# implementation directories and what the GUI drops next to the project
platforms/*/impl*/
platforms/*/*.dir/
platforms/*/.recovery
platforms/*/.*.ini
platforms/*/*.ini
platforms/*/*.html
platforms/*/*.htm
platforms/*/*.xml
platforms/*/*.log
platforms/*/*_tcl.html
platforms/*/pinfind/

# Clarity Designer: kept are the configuration (.sbx, .lpc), the constraints
# (.fdc) and the generated netlist (<ip>.v) that the project compiles.
# Everything else is regenerated by Clarity Designer.
platforms/*/ip/**/*.edn
platforms/*/ip/**/*.ngo
platforms/*/ip/**/*.cst
platforms/*/ip/**/*.cmd
platforms/*/ip/**/*.asd
platforms/*/ip/**/*_tmpl.v
platforms/*/ip/**/*_tmpl.vhd
platforms/*/ip/**/*.srp
platforms/*/ip/**/*.sym
platforms/*/ip/**/*.naf
platforms/*/ip/**/*.sort
platforms/*/ip/**/*.bak
platforms/*/ip/**/generate_core.tcl
platforms/*/ip/**/generate_ngd.tcl
platforms/*/ip/**/msg_file.log

# ---- Xilinx ISE ------------------------------------------------------------
# create_project.tcl puts the whole project into build/
platforms/*/build/
